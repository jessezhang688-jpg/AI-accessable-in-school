var GROQ_API_KEY = "YOUR_ACTRUAL_GROQ_API_KEY";

function doPost(e) {
  try {
    var requestData = JSON.parse(e.postData.contents);
    var frontendModel = requestData.model || "gpt-20b";
    var groqModel = "openai/gpt-oss-20b"; // Default fallback
    
    if (frontendModel === "gpt-120b") {
      groqModel = "openai/gpt-oss-120b"; 
    } else if (frontendModel === "gpt-20b") {
      groqModel = "openai/gpt-oss-20b"; 
    }

    var payload = {
      "model": groqModel,
      "messages": requestData.messages
    };

    if(requestData.reasoning_effort) {
      payload.reasoning_effort = requestData.reasoning_effort;
    }
    if(requestData.max_completion_tokens){
      payload.max_completion_tokens = requestData.max_completion_tokens;
    }

    var options = {
      "method": "post",
      "contentType": "application/json",
      "headers": {
        "Authorization": "Bearer " + GROQ_API_KEY
      },
      "payload": JSON.stringify(payload),
      "muteHttpExceptions": true
    };

    var response = UrlFetchApp.fetch("https://api.groq.com/openai/v1/chat/completions", options);
    var responseText = response.getContentText();
    
    return ContentService.createTextOutput(responseText)
      .setMimeType(ContentService.MimeType.JSON);

  } catch (error) {
    return ContentService.createTextOutput(JSON.stringify({ 
      "error": error.toString() 
    })).setMimeType(ContentService.MimeType.JSON);
  }
}